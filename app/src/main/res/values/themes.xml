<resources>
    <style name="Theme.Nvile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nvile_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Nvile.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nvile_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Nvile</item>
    </style>
</resources>
